{:paths   ["src" "resources" "target/classes"]
 :deps    {org.clojure/clojure      {:mvn/version "1.12.5"}
           org.clojure/data.int-map {:mvn/version "1.3.1"}
           org.clojure/data.json    {:mvn/version "2.5.2"}
           com.taoensso/nippy       {:mvn/version "3.8.1"}
           metosin/malli            {:mvn/version "0.20.1"}}
 :aliases {:build {:extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                                org.clojure/data.json         {:mvn/version "2.5.2"}}
                   :ns-default build}
           :run   {:jvm-opts  ["-XX:+UseG1GC" "-XX:MaxGCPauseMillis=5"
                               "-XX:G1PeriodicGCInterval=60000" "-Xmx1g"
                               "--sun-misc-unsafe-memory-access=allow"]
                   :main-opts ["-m" "collider.server"]}}}
