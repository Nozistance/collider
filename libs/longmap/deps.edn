{:paths   ["src" "target/classes"]
 :deps    {org.clojure/clojure {:mvn/version "1.12.5"}}
 :aliases {:build {:ns-default build
                   :deps       {io.github.clojure/tools.build
                                {:mvn/version "0.10.14"}}}
           :test  {:extra-paths ["test"]
                   :extra-deps  {org.clojure/test.check
                                 {:mvn/version "1.1.3"}}
                   :main-opts   ["-m" "longmap.runner"]}
           :bench {:extra-paths ["dev"]
                   :extra-deps  {org.clojure/data.int-map
                                 {:mvn/version "1.3.1"}}
                   :main-opts   ["-m" "longmap.bench"]}}
 :deps/prep-lib {:alias  :build
                 :fn     javac
                 :ensure "target/classes"}}
